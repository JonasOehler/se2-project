<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LMSPackage.GuiPackage.LMSController">
   <children>
      <BorderPane prefHeight="600.0" prefWidth="800.0">
         <center>
            <ListView fx:id="listViewBookList" prefHeight="401.0" prefWidth="239.0" BorderPane.alignment="CENTER" />
         </center>
         <top>
            <HBox alignment="CENTER" prefHeight="78.0" prefWidth="225.0" spacing="30.0" BorderPane.alignment="CENTER">
               <children>
                  <Button mnemonicParsing="false" onAction="#editBook" prefHeight="30.0" prefWidth="60.0" text="Edit" />
                  <Button fx:id="closeButton" mnemonicParsing="false" onAction="#deleteBook" prefHeight="30.0" prefWidth="60.0" text="Delete" />
                  <Button fx:id="closeButton1" layoutX="104.0" layoutY="36.0" mnemonicParsing="false" onAction="#showBookList" prefHeight="30.0" prefWidth="60.0" text="Show" />
               </children>
            </HBox>
         </top>
         <bottom>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="100.0" BorderPane.alignment="CENTER">
               <children>
                  <TextField fx:id="titleField" promptText="Title" />
                  <TextField fx:id="authorField" promptText="Author" />
                  <TextField fx:id="isbnField" promptText="ISBN" />
               </children>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
